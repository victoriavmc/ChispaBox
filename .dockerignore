# Dependencias y artefactos locales (se reinstalan y compilan dentro de la imagen)
node_modules
dist
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Control de versiones y editores
.git
.gitignore
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Docker y documentación (no necesarios para compilar)
Dockerfile
compose.yaml
.dockerignore
