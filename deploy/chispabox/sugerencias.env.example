# Plantilla. Copiar a sugerencias.env (en el VPS: chmod 600) y rellenar. NO subir el archivo real.

# Gmail: usar una contraseña de aplicación (requiere verificación en dos pasos en la cuenta).
# Crearla en https://myaccount.google.com/apppasswords. No es la contraseña normal de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=

# Buzón que recibe las sugerencias
MAIL_TO=tucorreo@gmail.com
# Remitente visible: nombre y la misma cuenta de Gmail
MAIL_FROM=ChispaBox <tucorreo@gmail.com>

# Sal para el hash de IP (solo para límites; generar con: openssl rand -hex 32)
IP_SALT=

# Origen del sitio. Solo se aceptan envíos que lleguen desde esta dirección (cabecera Origin).
# En local para probar: http://127.0.0.1:4173
ALLOWED_ORIGIN=https://tu-dominio.example

# Captcha propio (sin terceros): secreto que firma las preguntas. Generar con: openssl rand -hex 32
# Si se omite, se genera al arrancar y las preguntas pendientes caducan al reiniciar.
CAPTCHA_SECRET=
