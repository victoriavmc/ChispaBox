# Variables de los scripts de respaldo. Copiar a /opt/respaldo/respaldo.env (permisos 600) en el VPS.
# NO contiene valores secretos: los valores reales se escriben solo en el servidor.

# Clave PÚBLICA de age (archivo con una línea que empieza por age1...). La clave privada NO va al VPS.
RESPALDO_CLAVE_PUBLICA=/opt/respaldo/clave-publica-age.txt

# Destino rclone (nombre del remoto definido en rclone.conf, más el bucket).
RESPALDO_DESTINO=r2:chispabox-respaldos

# Directorio con proxy/.env (en deploy/proxy) y chispabox/sugerencias.env (en deploy/chispabox).
RESPALDO_CONFIG_DIR=/opt/src-chispabox/deploy

# Retención: borrar respaldos con más de N días, conservando siempre las últimas M versiones.
RESPALDO_RETENCION_DIAS=30
RESPALDO_VERSIONES_MIN=5

# Imagen para leer los volúmenes de Docker (versión fijada).
RESPALDO_IMAGEN_TAR=alpine:3.20
