# Configuración de las herramientas locales. Copiar a extras/local/.env (no se versiona).
# Rutas a los ejecutables. Si son solo nombres, se buscan en el PATH del sistema.
# Instalación recomendada: carpeta propia fuera del repositorio (ver README.md, sección 2).
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Carpeta temporal de trabajo de las descargas (se vacía al arrancar).
# YOUTUBE_TEMP_DIR=C:\Users\<usuario>\AppData\Local\Temp\chispabox-yt

# Límites de recursos
YOUTUBE_DOWNLOADS_ENABLED=true
YOUTUBE_MAX_CONCURRENT_JOBS=2
YOUTUBE_MAX_MINUTES=120
YOUTUBE_MAX_FILESIZE_MB=2048
YOUTUBE_JOB_TIMEOUT_MINUTES=30
YOUTUBE_RESULT_TTL_MINUTES=10
