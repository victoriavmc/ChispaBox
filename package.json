{
  "name": "mi-pagina-herramientas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landing page de ChispaBox — Pequeñas herramientas, grandes soluciones.",
  "scripts": {
    "predev": "node scripts/copy-pdfjs.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:documentos": "node --experimental-strip-types --no-warnings --test --test-timeout=0 \"tests/documentos-pdf/*.test.ts\"",
    "test:dividir-pdf": "node --experimental-strip-types --no-warnings --test \"tests/dividir-pdf/*.test.ts\"",
    "test:unificar-pdf": "node --experimental-strip-types --no-warnings --test \"tests/unificar-pdf/*.test.ts\"",
    "test:organizar-paginas": "node --experimental-strip-types --no-warnings --test \"tests/organizar-paginas/*.test.ts\"",
    "test:comprimir-pdf": "node --experimental-strip-types --no-warnings --test \"tests/comprimir-pdf/*.test.ts\"",
    "test:eliminar-metadatos": "node --experimental-strip-types --no-warnings --test \"tests/eliminar-metadatos/*.test.ts\"",
    "test:selector-color": "node --experimental-strip-types --no-warnings --test \"tests/selector-color/*.test.ts\"",
    "test:unificar-audios": "node --experimental-strip-types --no-warnings --test \"tests/unificar-audios/*.test.ts\"",
    "test:recortar-audio": "node --experimental-strip-types --no-warnings --test \"tests/recortar-audio/*.test.ts\"",
    "test:proteger-pdf": "node --experimental-strip-types --no-warnings --test \"tests/proteger-pdf/*.test.ts\"",
    "test:convertidor-datos": "node --experimental-strip-types --no-warnings --test \"tests/convertidor-datos/*.test.ts\"",
    "test:verificador-integridad": "node --experimental-strip-types --no-warnings --test \"tests/verificador-integridad/*.test.ts\"",
    "test:acortador-enlaces": "node --experimental-strip-types --no-warnings --test \"tests/acortador-enlaces/*.test.ts\"",
    "test:favicon": "node --experimental-strip-types --no-warnings --test \"tests/generador-favicon/*.test.ts\"",
    "test:nombre-archivo": "node --experimental-strip-types --no-warnings --test \"tests/nombre-archivo/*.test.ts\"",
    "test:qr": "node --experimental-strip-types --no-warnings --test \"tests/qr-contenido/*.test.ts\"",
    "test:redimensionar": "node --experimental-strip-types --no-warnings --test \"tests/redimensionar-imagen/*.test.ts\"",
    "test:formato-json-xml": "node --experimental-strip-types --no-warnings --test \"tests/formato-json-xml/*.test.ts\"",
    "test:contrasenas": "node --experimental-strip-types --no-warnings --test \"tests/generador-contrasenas/*.test.ts\"",
    "new-page": "node scripts/new-page.mjs",
    "copy:pdfjs": "node scripts/copy-pdfjs.mjs"
  },
  "devDependencies": {
    "@types/nspell": "^2.1.6",
    "@types/papaparse": "5.3.16",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "unpdf": "^1.9.1",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "dictionary-es": "^4.0.0",
    "jsqr": "1.4.0",
    "nspell": "^2.1.5",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "read-excel-file": "9.3.14"
  }
}
